# Copy to .env and fill in. Never commit .env.
BADGE_ADMIN_PASSWORD=change-me-to-a-long-random-password
BADGE_SESSION_SECRET=change-me-to-64-random-hex-chars
# Set to 0 only when testing over plain http locally.
BADGE_COOKIE_SECURE=1
# Host port the server listens on (default 80). If 80 is taken, use one of the
# ports Cloudflare proxies over HTTP: 8080, 8880, 2052, 2082, 2086, 2095.
# BADGE_HOST_PORT=8080
# Optional overrides:
# BADGE_DATA_DIR=./data
